params {
    // General parameters
    datadir = "${launchDir}/data"
    outdir = "${launchDir}/resultssimB"
    reference = "${launchDir}/chipB"
    work_dir = "${launchDir}/work"

    // Reference genomes and chromosome names files
    ref_current = "${reference}/old_ref.fa"
    v_current = "old"
    ref_new = "${reference}/new_ref.fa"
    v_new = "new"
    scripts = "${launchDir}/scripts"
    

    // Marker data and flank size
    markers = "${reference}/markers_old.tsv"
    flank_size = 50

}

params.manifest=manifest