// Pipeline parameters
includeConfig "${launchDir}/params.config"
 
// Metadata
manifest {
    author  = "Svetlana Afonnikova"
    version = "1.0.0"
    name    = "Pipeline to convert marker position from one genome assembly version to another"
}
 
// Default process settings
process {
    executor = 'local'
    cpus     = 2
    memory   = '4 GB'
}
 
profiles {
 
    standard {
        process.executor = 'local'
    }
 
    conda {
        conda.enabled  = true
        process.conda  = "${launchDir}/env_SNPfix.yml"
    }
 
    slurm {
        conda.enabled = true
        process {
            executor  = 'slurm'
            queueSize = 4
            cpus      = 4
            memory    = 20.GB
            conda     = "${launchDir}/env_SNPfix.yml"
        }
    }
 
    // For GitHub Actions / CI/CD
    test {
        process.executor = 'local'
        process.cpus     = 1
        process.memory   = 1.GB
        params.markers   = "${launchDir}/assets/markers_asm1.tsv"
    }
}
 
// Reports
timeline {
    enabled   = true
    overwrite = true
}
report {
    enabled   = true
    overwrite = true
}
trace {
    enabled   = true
    file      = 'trace.txt'
    overwrite = true
}
