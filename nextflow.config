// Pipeline config
includeConfig "${launchDir}/params.config"



// Metadata
manifest {
    author = "Svetlana Afonnikova"
    version = "1.0.0"
    name = "Pipeline to convert marker position from one genome assembly version to another"
}



trace {
enabled = true
file = 'trace.txt'
}

// Настройка Conda (опционально — можно отключить, если используете контейнеры)
//

conda {
    enabled = true
    //useMamba = true}
}

// Processes
process {
    executor = 'slurm'
    queueSize = 4
    cpus = 4
    memory = '20 GB'
    queue = 'amd_256M'

    // environment
    conda = '/home/afonnikovasvetlana/miniforge3/envs/chip'

}




