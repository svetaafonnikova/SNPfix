// Pipeline config
includeConfig "${launchDir}/params.config"



// Metadata
manifest {
    author = "Svetlana Afonnikova"
    version = "1.0.0"
    name = "Pipeline to convert marker position from one genome assembly version to another"
}



trace {
enabled = true
file = 'trace.txt'
}


conda {
    enabled = true
}

// Processes
process {
    executor = 'local'
    cpus = 2
    memory = '4 GB'

    }

profiles {

    standard {
        process.executor = 'local'
    }

    conda {
        process.conda = "${launchDir}/env_SNPfix.yml"
    }

    
    slurm {
        process {
            executor = 'slurm'
            queueSize = 4
            cpus = 4
            memory = 20.GB
            queue = null
            conda = 'env_SNPfix.yml'
        }
        
            // 6. TEST (For GitHub Actions / CI/CD)
    test {
        process.executor = 'local'
        process.cpus = 1
        process.memory = 1.GB
    }
}

timeline { enabled = true }
report { enabled = true }
trace { enabled = true }
    }




