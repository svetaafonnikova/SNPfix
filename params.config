// Extract all the parameters from the RNAseq.nf script and paste them in this separate params.config file. 
// Define project parameters needed for running the pipeline
params {
    // General parameters
    datadir = "${launchDir}/data"
    outdir = "${launchDir}/results"
    reference = "${launchDir}/reference"
    work_dir = "${launchDir}/work"

    // Reference genomes and chromosome names files
    ref_current = "${reference}/bostaurus_UMD3.1.1.fna"
    v_current = "umd3"
    ref_new = "${reference}/Bos_taurus.ARS-UCD1.3.dna.toplevel.fa"
    v_new = "ARS-UCD1"
    scripts = "${launchDir}/scripts"
    

    // Marker data and flank size
    markers = "${datadir}/bostaurus_50kUMD3.txt"
    flank_size = 50

}

params.manifest=manifest