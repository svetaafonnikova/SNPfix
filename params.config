params {
    // General parameters
    datadir = "${launchDir}/data"
    outdir = "${launchDir}/results"
    reference = "${launchDir}/reference"
    work_dir = "${launchDir}/work"

    // Reference genomes and chromosome names files
    ref_current = null
    v_current = null
    ref_new = null
    v_new = null
    scripts = "${launchDir}/scripts"
    

    // Marker data and flank size
    markers = null
    flank_size = 50

}

params.manifest=manifest