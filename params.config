params {
    // General parameters
    datadir   = "${launchDir}/assets"
    outdir    = "${launchDir}/results"
    reference = "${launchDir}/assets"
    work_dir  = "${launchDir}/work"
    scripts   = "${launchDir}/scripts"

    // Reference genomes and assembly version names
    ref_current = "${params.datadir}/assembly1.fasta"
    v_current   = "asmb1"
    ref_new     = "${params.datadir}/assembly2.fasta"
    v_new       = "asmb2"

    // Marker data and flank size
    markers    = "${params.datadir}/markers_asm1.tsv"
    flank_size = 50
}
